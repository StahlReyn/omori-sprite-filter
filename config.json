{
  "default_preset": "standard",
  "templates": {
    "portrait_sharpen": {
      "enabled": true,
      "radius": 1,
      "percent": 25,
      "threshold": 0
    }
  },
  "presets": {
    "standard": {
      "description": "Animated sprite sheet with emotion effects.",
      "type": "animated",
      "variant_names": [
        "neutral",
        "sad",
        "angry",
        "happy"
      ],
      "frame_order": [0, 1, 2, 1],
      "row_reuse": {
        "hurt": "sad",
        "defeat": "sad"
      },
      "lighten_hurt": true,
      "invert_defeat": true,
      "resize_settings": {
        "enabled": true,
        "scale": 0.5,
        "resampling": "bilinear",
        "sharpen": {
          "enabled": true,
          "radius": 1,
          "percent": 50,
          "threshold": 0
        }
      },
      "glow_colors": {
        "sad": [0, 100, 255],
        "angry": [255, 0, 50],
        "happy": [255, 220, 0]
      },
      "glow_settings": {
        "blur_radius": 3,
        "expand_size": 7,
        "pick_radius": 2,
        "multiply_strength": 0.1
      }
    },
    "portrait_menu": {
      "description": "Crop and resize portrait sprites for menus.",
      "type": "portrait",
      "columns": 3,
      "crop": {
        "left": 0,
        "top": 0,
        "right": 512,
        "bottom": 512
      },
      "resize": {
        "width": 128,
        "height": 128
      },
      "resampling": "lanczos",
      "sharpen": {
        "$template": "portrait_sharpen"
      }
    },
    "portrait_battle_crop": {
      "description": "Crop and resize portrait sprites for battle.",
      "type": "portrait",
      "columns": 3,
      "crop": {
        "left": 44,
        "top": 88,
        "right": 468,
        "bottom": 512
      },
      "resize": {
        "width": 106,
        "height": 106
      },
      "resampling": "lanczos",
      "sharpen": {
        "$template": "portrait_sharpen"
      }
    },
    "portrait_dialogue_crop": {
      "description": "Crop and resize portrait sprites for dialogue.",
      "type": "portrait",
      "columns": 4,
      "crop": {
        "left": 138,
        "top": 276,
        "right": 562,
        "bottom": 700
      },
      "resize": {
        "width": 106,
        "height": 106
      },
      "resampling": "lanczos",
      "sharpen": {
        "$template": "portrait_sharpen"
      }
    }
  }
}

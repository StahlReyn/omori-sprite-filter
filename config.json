{
  "default_setup": "standard_4",
  "default_running_config": "half_size_bilinear",
  "templates": {
    "default_sharpen": {
      "enabled": true,
      "radius": 1,
      "percent": 25,
      "threshold": 0
    },
    "standard_glow_colors": {
      "sad": [0, 100, 255],
      "angry": [255, 0, 50],
      "happy": [255, 220, 0]
    }
  },
  "animated_defaults": {
    "type": "animated",
    "lighten_hurt": true,
    "invert_defeat": true,
    "glow_colors": {"$template": "standard_glow_colors"},
    "glow_settings": {
      "blur_radius": 3,
      "expand_size": 7,
      "pick_radius": 2,
      "multiply_strength": 0.1
    }
  },
  "animated_setups": {
    "standard_4": {
      "label": "Standard 4 emotion",
      "description": "4 emotions, 4 output frames.",
      "variant_names": ["neutral", "sad", "angry", "happy"],
      "row_reuse": {
        "neutral": "neutral",
        "hurt": "sad",
        "defeat": "sad",
        "sad": "sad",
        "angry": "angry",
        "happy": "happy"
      },
      "frame_order": [0, 1, 2, 1],
      "prompt_hurt_defeat": true
    },
    "standard_6": {
      "label": "Standard 6",
      "description": "4 emotions, 6 output frames.",
      "variant_names": ["neutral", "sad", "angry", "happy"],
      "row_reuse": {
        "neutral": "neutral",
        "hurt": "sad",
        "defeat": "sad",
        "sad": "sad",
        "angry": "angry",
        "happy": "happy"
      },
      "frame_order": [0, 1, 2, 3, 4, 5]
    },
    "standard_1": {
      "label": "Standard 1 (neutral all)",
      "description": "1 neutral emotion reused for every output row.",
      "variant_names": ["neutral"],
      "row_reuse": {
        "neutral": "neutral",
        "hurt": "neutral",
        "defeat": "neutral",
        "sad": "neutral",
        "angry": "neutral",
        "happy": "neutral"
      },
      "frame_order": [0, 1, 2, 1]
    },
    "three_emotion_neutral_reuse": {
      "label": "3 emotion + 1 neutral reuse",
      "description": "3 emotions; choose one to reuse for neutral.",
      "variant_names": ["sad", "angry", "happy"],
      "row_reuse": {
        "neutral": "sad",
        "hurt": "sad",
        "defeat": "sad",
        "sad": "sad",
        "angry": "angry",
        "happy": "happy"
      },
      "frame_order": [0, 1, 2, 1],
      "prompt_neutral_reuse": true,
      "prompt_hurt_defeat": true
    }
  },
  "running_configs": {
    "half_size_bilinear": {
      "description": "Half size, bilinear resize.",
      "resize": {
        "enabled": true,
        "scale": 0.5,
        "resampling": "bilinear",
        "sharpen": {"$template": "default_sharpen"}
      }
    },
    "half_size_nearest": {
      "description": "Half size, nearest-neighbor resize.",
      "resize": {
        "enabled": true,
        "scale": 0.5,
        "resampling": "nearest",
        "sharpen": {"$template": "default_sharpen"}
      }
    },
    "original_size": {
      "description": "Keep original size.",
      "resize": {
        "enabled": false,
        "scale": 1,
        "resampling": "bilinear",
        "sharpen": {"$template": "default_sharpen"}
      }
    }
  },
  "presets": {
    "portrait_base": {
      "description": "Shared portrait processing settings.",
      "type": "portrait",
      "columns": 3,
      "resize": {
        "width": 106,
        "height": 106,
        "resampling": "bilinear",
        "sharpen": {
          "$template": "default_sharpen"
        }
      }
    },
    "portrait_menu": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for menus. (Intended for 512x512)",
      "resize": {
        "width": 128,
        "height": 128,
        "resampling": "bilinear",
        "sharpen": {
          "$template": "default_sharpen"
        }
      }
    },
    "portrait_battle_crop": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for battle. (Intended for 512x512)",
      "crop": {
        "left": 44,
        "top": 88,
        "right": 468,
        "bottom": 512
      }
    },
    "portrait_dialogue_crop": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for dialogue. (Intended for 700x700)",
      "columns": 4,
      "crop": {
        "left": 138,
        "top": 276,
        "right": 562,
        "bottom": 700
      }
    }
  }
}

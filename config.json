{
  "default_preset": "standard",
  "templates": {
    "default_sharpen": {
      "enabled": true,
      "radius": 1,
      "percent": 25,
      "threshold": 0
    }
  },
  "custom_options": {
    "variant_names": [
      ["neutral"],
      ["neutral", "sad", "angry", "happy"]
    ],
    "frames_per_variant": [
      1,
      2,
      3,
      4
    ],
    "frame_order": [
      [0],
      [0, 1],
      [0, 1, 2],
      [0, 1, 2, 1]
    ],
    "row_reuse": [
      {
        "neutral": "neutral",
        "hurt": "neutral",
        "defeat": "neutral",
        "sad": "neutral",
        "angry": "neutral",
        "happy": "neutral"
      },
      {"hurt": "sad", "defeat": "sad"}
    ],
    "invert_defeat": [
      false,
      true
    ],
    "resize": [
      {
        "enabled": true,
        "scale": 0.5,
        "resampling": "bilinear",
        "sharpen": {"$template": "default_sharpen"}
      },
      {
        "enabled": true,
        "scale": 0.25,
        "resampling": "bilinear",
        "sharpen": {"$template": "default_sharpen"}
      },
      {"enabled": false}
    ]
  },
  "presets": {
    "standard": {
      "description": "Standard enemy sprite sheet. Uses sad for hurt/defeat.",
      "type": "animated",
      "variant_names": [
        "neutral",
        "sad",
        "angry",
        "happy"
      ],
      "frames_per_variant": 3,
      "row_reuse": {
        "hurt": "sad",
        "defeat": "sad"
      },
      "frame_order": [0, 1, 2, 1],
      "lighten_hurt": true,
      "invert_defeat": true,
      "resize": {
        "enabled": true,
        "scale": 0.5,
        "resampling": "bilinear",
        "sharpen": {
          "$template": "default_sharpen"
        }
      },
      "glow_colors": {
        "sad": [0, 100, 255],
        "angry": [255, 0, 50],
        "happy": [255, 220, 0]
      },
      "glow_settings": {
        "blur_radius": 3,
        "expand_size": 7,
        "pick_radius": 2,
        "multiply_strength": 0.1
      }
    },
    "standard_boss": {
      "$extends": "standard",
      "description": "Animated sprite sheet without defeat inversion.",
      "invert_defeat": false
    },
    "standard_three_frame": {
      "$extends": "standard",
      "description": "Standard animated sprite sheet with three output frames.",
      "frame_order": [0, 1, 2]
    },
    "standard_two_frame": {
      "$extends": "standard",
      "description": "Standard animated sprite sheet with two output frames.",
      "frame_order": [0, 1]
    },
    "standard_neutral": {
      "$extends": "standard",
      "description": "Animated sprite with only neutral animated.",
      "variant_names": [
        "neutral"
      ],
      "row_reuse": {
        "sad": "neutral",
        "angry": "neutral",
        "happy": "neutral",
        "hurt": "neutral",
        "defeat": "neutral"
      }
    },
    "standard_neutral_boss": {
      "$extends": "standard_neutral",
      "description": "Standard neutral only without inversion.",
      "invert_defeat": false
    },
    "portrait_base": {
      "description": "Shared portrait processing settings.",
      "type": "portrait",
      "columns": 3,
      "resize": {
        "width": 106,
        "height": 106,
        "resampling": "bilinear",
        "sharpen": {
          "$template": "default_sharpen"
        }
      }
    },
    "portrait_menu": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for menus. (Intended for 512x512)",
      "resize": {
        "width": 128,
        "height": 128,
        "resampling": "bilinear",
        "sharpen": {
          "$template": "default_sharpen"
        }
      }
    },
    "portrait_battle_crop": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for battle. (Intended for 512x512)",
      "crop": {
        "left": 44,
        "top": 88,
        "right": 468,
        "bottom": 512
      }
    },
    "portrait_dialogue_crop": {
      "$extends": "portrait_base",
      "description": "Crop and resize portrait sprites for dialogue. (Intended for 700x700)",
      "columns": 4,
      "crop": {
        "left": 138,
        "top": 276,
        "right": 562,
        "bottom": 700
      }
    }
  }
}
